<?xml version="1.0" ?>
<!-- 散布障碍物场地（SLAM 建图演示用，图1 风格）
     12m x 12m 围墙场地，16 个方形/圆柱障碍，全部内联模型（不依赖 Gazebo 在线模型库）。
     障碍近似落在 2m 网格上并加抖动，保证任意两障碍边缘间距 >= 0.8m，留出可通行走廊。 -->
<sdf version="1.6">
  <world name="obstacle_field">
    <!-- 打开 Gazebo 时的默认视角: 抬高俯视, 保证 12x12 场地与机器人都在画面内 -->
    <gui>
      <camera name="user_camera">
        <pose>0 -11 13 0 0.75 0</pose>
      </camera>
    </gui>

    <!-- ================= 太阳（内联，不引用 model://sun） ================= -->
    <model name="sun">
      <static>true</static>
      <link name="link">
        <light type="directional" name="light">
          <cast_shadows>true</cast_shadows>
          <diffuse>0.9 0.9 0.9 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
          <direction>-0.4 0.4 -0.8</direction>
        </light>
      </link>
    </model>

    <!-- ================= 地面（内联，不引用 model://ground_plane） ================= -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= 围墙（12m x 12m，墙厚 0.2m 高 0.8m） ================= -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 6 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.4 0.2 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.4 0.2 0.8</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.58 1</ambient>
            <diffuse>0.65 0.65 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -6 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.4 0.2 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.4 0.2 0.8</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.58 1</ambient>
            <diffuse>0.65 0.65 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>6 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 12.4 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 12.4 0.8</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.58 1</ambient>
            <diffuse>0.65 0.65 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-6 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 12.4 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 12.4 0.8</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.58 1</ambient>
            <diffuse>0.65 0.65 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= 散布障碍（默认白色，个别配色点缀） ================= -->
    <!-- 1: 西南方向大方块 -->
    <model name="obstacle_01">
      <static>true</static>
      <pose>-3.7 -2.2 0.3 0 0 0.35</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 0.6</size></box></geometry>
          <material>
            <ambient>0.92 0.92 0.92 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 2 -->
    <model name="obstacle_02">
      <static>true</static>
      <pose>-1.6 -4.3 0.45 0 0 -0.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.8 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.9</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.94 0.94 0.94 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 3: 圆柱 -->
    <model name="obstacle_03">
      <static>true</static>
      <pose>-2.3 -1.7 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.4</radius><length>0.7</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>0.7</length></cylinder></geometry>
          <material>
            <ambient>0.3 0.5 0.85 1</ambient>
            <diffuse>0.35 0.58 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 4 -->
    <model name="obstacle_04">
      <static>true</static>
      <pose>0.3 -3.8 0.25 0 0 0.15</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.8 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.8 0.5</size></box></geometry>
          <material>
            <ambient>0.92 0.92 0.92 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 5: 高窄方块 -->
    <model name="obstacle_05">
      <static>true</static>
      <pose>-0.2 -1.8 0.5 0 0 0.5</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 1.0</size></box></geometry>
          <material>
            <ambient>0.88 0.88 0.88 1</ambient>
            <diffuse>0.92 0.92 0.92 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 6: 圆柱 -->
    <model name="obstacle_06">
      <static>true</static>
      <pose>2.2 -1.6 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.35</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.35</radius><length>0.9</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.62 0.2 1</ambient>
            <diffuse>1.0 0.66 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 7 -->
    <model name="obstacle_07">
      <static>true</static>
      <pose>4.1 -2.4 0.3 0 0 -0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.7 1.0 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.7 1.0 0.6</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.94 0.94 0.94 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 8 -->
    <model name="obstacle_08">
      <static>true</static>
      <pose>-4.2 0.3 0.4 0 0 0.1</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.9 0.9 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.9 0.9 0.8</size></box></geometry>
          <material>
            <ambient>0.92 0.92 0.92 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 9: 中央大圆柱 -->
    <model name="obstacle_09">
      <static>true</static>
      <pose>0.1 0.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.45</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.45</radius><length>1.0</length></cylinder></geometry>
          <material>
            <ambient>0.3 0.6 0.4 1</ambient>
            <diffuse>0.35 0.7 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 10 -->
    <model name="obstacle_10">
      <static>true</static>
      <pose>2.3 0.1 0.45 0 0 0.25</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.1 0.8 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.1 0.8 0.9</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.94 0.94 0.94 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 11 -->
    <model name="obstacle_11">
      <static>true</static>
      <pose>-2.4 2.3 0.5 0 0 0.45</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.7 0.7 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.7 0.7 1.0</size></box></geometry>
          <material>
            <ambient>0.88 0.88 0.88 1</ambient>
            <diffuse>0.92 0.92 0.92 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 12 -->
    <model name="obstacle_12">
      <static>true</static>
      <pose>0.4 2.1 0.3 0 0 -0.1</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 1.1 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 1.1 0.6</size></box></geometry>
          <material>
            <ambient>0.92 0.92 0.92 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 13: 圆柱 -->
    <model name="obstacle_13">
      <static>true</static>
      <pose>2.1 2.4 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.4</radius><length>0.8</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>0.8</length></cylinder></geometry>
          <material>
            <ambient>0.6 0.45 0.7 1</ambient>
            <diffuse>0.68 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 14 -->
    <model name="obstacle_14">
      <static>true</static>
      <pose>-3.9 2.2 0.35 0 0 0.6</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.6 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.6 0.7</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.94 0.94 0.94 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 15 -->
    <model name="obstacle_15">
      <static>true</static>
      <pose>0.2 4.1 0.4 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.8 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.8 0.8</size></box></geometry>
          <material>
            <ambient>0.92 0.92 0.92 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 16: 圆柱 -->
    <model name="obstacle_16">
      <static>true</static>
      <pose>-2.2 4.3 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.35</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.35</radius><length>0.9</length></cylinder></geometry>
          <material>
            <ambient>0.85 0.4 0.35 1</ambient>
            <diffuse>0.92 0.45 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
